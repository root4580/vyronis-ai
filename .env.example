# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override default storage bucket for trade screenshots
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=trade-screenshots

# Optional: used for auth email redirects in local development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional: canonical app URL for SEO metadata (production)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# AI provider: openai | claude | gemini | heuristic
AI_PROVIDER=openai
CHART_VISION_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o

# Anthropic (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_VISION_MODEL=claude-sonnet-4-20250514

# Google Gemini (optional)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_VISION_MODEL=gemini-2.0-flash
