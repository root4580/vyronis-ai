# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override default storage bucket for trade screenshots
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=trade-screenshots

# Optional: used for auth email redirects in local development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Required in production (Vercel): canonical app URL for auth redirects & metadata
NEXT_PUBLIC_APP_URL=https://vyronishq.com

# Supabase Dashboard → Authentication → Redirect URLs must also include:
# https://vyronishq.com/auth/callback
# (Password reset emails use /auth/callback?next=/auth/reset-password)

# Auth email delivery: configure Resend SMTP in Supabase (NOT in Next.js env).
# See docs/SUPABASE-RESEND-SETUP.md

# TradingView alert emails (Grade A+ / B only) — Resend HTTP API (server-only, optional)
# App skips email when RESEND_API_KEY is unset. Dev logs the payload instead.
# Test sender (no domain): onboarding@resend.dev
# RESEND_API_KEY=re_...
# EMAIL_FROM=Vyronis HQ <alerts@vyronishq.com>

# MT5 Research Lab (Phase A): enable per user in Supabase user_settings.research_lab_enabled
# Run supabase/010-research-lab-foundation.sql before enabling.

# MT5 EA trade webhook — run supabase/023-mt5-trade-webhook.sql
# Per-user API key: GET /api/mt5/settings (authenticated). EA POSTs to /api/webhooks/mt5/trades
# Requires SUPABASE_SERVICE_ROLE_KEY on the server. See docs/MT5-EA-WEBHOOK.md
# SUPABASE_SECRET_KEY=sb_secret_...  (Dashboard → API Keys → Secret; same project as URL above)
# MT5_WEBHOOK_API_KEY=from GET /api/mt5/settings while logged in
# MT5_TEST_EMAIL=optional for npm run mt5:quick-test
# MT5_TEST_PASSWORD=optional for npm run mt5:quick-test

# AI provider: openai | claude | gemini | heuristic
AI_PROVIDER=openai
CHART_VISION_PROVIDER=openai

# OpenAI (War Room vision, Vyronis AI Router — server-side only, never NEXT_PUBLIC_*)
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_WHISPER_MODEL=whisper-1
# MT5 screenshot times are broker server clock → UTC offset (3 = EEST summer, 2 = EET winter)
MT5_SCREENSHOT_UTC_OFFSET=3

# Anthropic Claude (Vyronis AI Router fallback — server-side only)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_VISION_MODEL=claude-sonnet-4-20250514
# CLAUDE_TEXT_MODEL=claude-sonnet-4-20250514

# Google Gemini (Vyronis AI Router fallback — server-side only)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_VISION_MODEL=gemini-2.0-flash
# GEMINI_TEXT_MODEL=gemini-2.0-flash

# AI Trading Council — ElevenLabs voice output (Phase 2, server-side only)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional per-agent voice overrides (defaults to ElevenLabs premade voices):
# ELEVENLABS_NOVA_VOICE_ID=
# ELEVENLABS_ZARA_VOICE_ID=
# ELEVENLABS_REX_VOICE_ID=
# ELEVENLABS_LUNA_VOICE_ID=
# ELEVENLABS_CIPHER_VOICE_ID=
# Legacy env keys (still supported): ELEVENLABS_SARAH_VOICE_ID, ELEVENLABS_ADAM_VOICE_ID, etc.
