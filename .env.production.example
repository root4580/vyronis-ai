# Copy this file to .env.local for local dev.
# Set all values in Vercel dashboard before deploying to production.

# --- Required for production ---
CRON_SECRET=              # Required: Vercel cron auth header
NEXT_PUBLIC_SUPABASE_URL= # Required: Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=# Required: Supabase service role for server

# --- Optional: Resend (alerts, weekly debrief, team notify) ---
# App works without these — emails are skipped, not crashed.
# Test sender (no custom domain): onboarding@resend.dev
# RESEND_API_KEY=
# EMAIL_FROM=Vyronis HQ <alerts@vyronishq.com>   # after vyronishq.com verified in Resend

# --- Playwright CI / local E2E only (not Vercel production) ---
E2E_EMAIL=
E2E_PASSWORD=
